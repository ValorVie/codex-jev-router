# Keep the real value in ~/.jev-codex.env or the process environment.
JEV_API_KEY=your_typesafe_api_key

# 1 enables Jev-derived reasoning effort; 0 preserves Codex's selected effort.
JEV_CODEX_AUTO_EFFORT=1

# Optional overrides.
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_CODEX_API_BASE_URL=https://api.openai.com/v1
# JEV_CODEX_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex

# Optional routing-pool controls. When unset, all Codex-advertised models/efforts remain eligible.
# Exact model IDs, comma-separated.
# JEV_CODEX_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
# Exact effort names, comma-separated.
# JEV_CODEX_EFFORTS=low,medium,high,max
# Optional lower/upper effort bounds.
# JEV_CODEX_MIN_EFFORT=medium
# JEV_CODEX_MAX_EFFORT=high
