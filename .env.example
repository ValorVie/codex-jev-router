# Keep the real value in ~/.jev-codex.env or the process environment.
JEV_API_KEY=replace-with-your-typesafe-key

# 1 enables Jev-derived reasoning effort; 0 preserves Codex's selected effort.
JEV_CODEX_AUTO_EFFORT=1

# Optional overrides.
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_CODEX_API_BASE_URL=https://api.openai.com/v1
# JEV_CODEX_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex
